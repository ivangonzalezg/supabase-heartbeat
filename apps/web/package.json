{
  "name": "@supabase-heartbeat/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "steiger": "steiger ./src",
    "tailwind": "tailwind-suggest-canonical-classes \"src/**/*.tsx\" --css src/index.css",
    "validate": "yarn lint && yarn typecheck && yarn format && yarn steiger && yarn tailwind",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5",
    "@supabase-heartbeat/validation": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "humanize-duration": "^3.34.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/humanize-duration": "^3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "steiger": "^0.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.10"
  }
}
