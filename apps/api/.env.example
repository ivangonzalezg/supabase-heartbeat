DATABASE_PATH=./data/supabase-heartbeat.db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-at-least-32-characters
PORT=3000
NODE_ENV=development

# Optional first-administrator bootstrap. Public sign-up is disabled, so the
# only way to get an initial account is either this bootstrap or manual
# database access. FIRST_ADMIN_EMAIL and FIRST_ADMIN_PASSWORD must be set
# together as a group: setting only one fails startup with a configuration
# error. FIRST_ADMIN_NAME is optional and defaults to "Admin".
#
# Bootstrap runs once at startup and only creates an administrator when none
# already exists; it is safe to leave these variables set across restarts
# (idempotent) or to remove them entirely once the administrator has been
# created and verified — the created administrator is stored in SQLite and
# is unaffected by removing these variables. FIRST_ADMIN_PASSWORD is a
# bootstrap secret: supply it through container secrets, your deployment's
# secret store, or another protected configuration mechanism, and remove it
# after first use unless your secret-management workflow intentionally
# retains it. Never commit a real value.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-a-strong-initial-password
FIRST_ADMIN_NAME=Admin

# Enables the real cron scheduler: on startup (and whenever a workflow's
# schedule/enabled state changes), every workflow with enabled = true gets
# a real, timer-backed CronJob that fires scheduled runs at its
# cronExpression/timezone. Disabled by default — set to "true" to enable.
# Manual execution via the Workflow Runs API is unaffected either way.
SCHEDULER_ENABLED=false
