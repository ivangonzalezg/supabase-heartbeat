# Docker Compose configuration for Supabase Heartbeat.
# Copy to .env in the repository root and fill in real values before running
# `docker compose up`. See apps/api/.env.example and
# apps/api/README.md#environment-variables for what each variable controls.

# Host port the app is published on (the container always listens on 3000
# internally, matching the single-port design).
PORT=7854

DATABASE_PATH=./data/supabase-heartbeat.db

# BETTER_AUTH_URL: the public URL where users actually reach the app in
# their browser. Left unset here on purpose — docker-compose.yml defaults
# it to http://localhost:PORT, automatically following PORT above, which is
# fine if you expose the container directly with no proxy in front. If you
# put a reverse proxy in front instead (Traefik, Nginx, Caddy, a platform
# load balancer, ...) with its own domain/subdomain and TLS termination,
# uncomment the line below and set it to that proxy's public URL (e.g.
# https://heartbeat.example.com) — the PORT-based default is wrong in that
# case, since browsers never talk to the container's port directly. Better
# Auth uses this only to build its own absolute URLs internally; it is
# unrelated to the frontend, which always uses relative /api/... requests.
# BETTER_AUTH_URL=https://heartbeat.example.com

BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-at-least-32-characters

# Optional first-administrator bootstrap — see apps/api/README.md
# #first-administrator-bootstrap. Leave both unset to skip it.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Admin

SCHEDULER_ENABLED=false
